rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reviews/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /announcements/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
