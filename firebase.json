{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "README.md",
      "node_modules/**",
      "functions/**",
      ".gitignore"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/firebase-client.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000,stale-while-revalidate=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/paystack/initialize",
        "function": {
          "functionId": "initializePaystackPayment",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/paystack/verify",
        "function": {
          "functionId": "verifyPaystackPayment",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/paystack/webhook",
        "function": {
          "functionId": "paystackWebhook",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/checkout-status",
        "function": {
          "functionId": "checkoutStatus",
          "region": "europe-west1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}
